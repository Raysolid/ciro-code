{
  "name": "@ciro/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ciro": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "dev": "tsx src/cli.ts web --no-open",
    "dev:mock": "tsx src/cli.ts web --no-open --mock",
    "dev:watch": "tsx watch --exclude \"**/node_modules/**\" --exclude \"**/dist/**\" --exclude \"**/*.tsbuildinfo\" --exclude \"**/harness-ui/dist/**\" src/cli.ts web --no-open",
    "dev:api:watch": "tsx watch --exclude \"**/node_modules/**\" --exclude \"**/dist/**\" --exclude \"**/*.tsbuildinfo\" --exclude \"**/harness-ui/dist/**\" src/cli.ts web --no-open",
    "dev:cli": "tsx src/cli.ts",
    "pack:smoke": "pnpm run build && npm pack --dry-run"
  },
  "dependencies": {
    "@ciro/harness-core": "workspace:*",
    "@ciro/harness-shared": "workspace:*",
    "@ciro/harness-web": "workspace:*",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
