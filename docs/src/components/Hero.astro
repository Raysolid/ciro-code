---
import Default from '@astrojs/starlight/components/Hero.astro';

const { entry, locale } = Astro.locals.starlightRoute;
const { data } = entry;
const hero = data.hero;
const isHome = data.template === 'splash';
const isZh = locale === 'zh-cn';

const title = isZh ? '文档' : 'Documentation';
const tagline = isZh
  ? '在本机工作台里指挥编码 Agent——Ask / Plan / Agent / Debug，权限清晰，改动可审。'
  : 'Steer a coding agent from a local workbench — Ask, Plan, Agent, Debug with clear permissions and reviewable changes.';
---

{
  isHome && hero ? (
    <div class="docs-home-hero">
      <h1 id="_top" data-page-title>
        {title}
      </h1>
      <p class="tagline">{tagline}</p>
    </div>
  ) : (
    <Default>
      <slot />
    </Default>
  )
}
