---
interface Props {
  copyLabel?: string;
  copiedLabel?: string;
  hint?: string;
  eta?: string;
  label?: string;
}

const {
  copyLabel = 'Copy',
  copiedLabel = 'Copied',
  hint = 'Requires Node.js 20+. No API key yet? Run ciro web --mock.',
  eta = '~5 min',
  label = 'Quickstart',
} = Astro.props;
---

<div class="docs-qs">
  <div class="docs-qs__head">
    <p class="docs-qs__label">{label}</p>
    <span class="docs-qs__eta">{eta}</span>
  </div>
  <div class="docs-qs__rows">
    <div class="docs-cmd" data-command="npm install -g @ciro-code/code" data-copied={copiedLabel}>
      <code
        ><span class="prompt">$</span> npm install -g <span class="pkg">@ciro-code/code</span></code
      >
      <button type="button" class="docs-cmd__btn" data-copy aria-label={copyLabel}>
        <span data-label>{copyLabel}</span>
      </button>
    </div>
    <div class="docs-cmd" data-command="ciro web" data-copied={copiedLabel}>
      <code
        ><span class="prompt">$</span> ciro web <span class="cmt"># → http://127.0.0.1:3080</span></code
      >
      <button type="button" class="docs-cmd__btn" data-copy aria-label={copyLabel}>
        <span data-label>{copyLabel}</span>
      </button>
    </div>
  </div>
  <p class="docs-qs__hint" set:html={hint} />
</div>

<script>
  document.querySelectorAll<HTMLElement>('.docs-cmd').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-copy]');
    const label = root.querySelector<HTMLElement>('[data-label]');
    const command = root.dataset.command ?? '';
    if (!btn || !label) return;
    const idle = label.textContent ?? 'Copy';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(command);
        label.textContent = root.dataset.copied || 'Copied';
        btn.classList.add('is-copied');
        setTimeout(() => {
          label.textContent = idle;
          btn.classList.remove('is-copied');
        }, 1200);
      } catch {
        /* ignore */
      }
    });
  });
</script>
