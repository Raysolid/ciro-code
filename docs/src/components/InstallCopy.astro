---
interface Props {
  copyLabel?: string;
  copiedLabel?: string;
  commentInstall?: string;
  commentStart?: string;
}

const {
  copyLabel = 'Copy',
  copiedLabel = 'Copied',
  commentInstall = '# Install CLI',
  commentStart = '# Start local workbench',
} = Astro.props;

const copyText = `npm install -g @ciro-code/code
ciro web`;
---

<div class="install-copy" data-command={copyText} data-copied={copiedLabel}>
  <button type="button" class="install-copy__btn" data-copy aria-label={copyLabel}>
    <span data-label>{copyLabel}</span>
  </button>
  <code class="install-copy__line install-copy__line--comment">{commentInstall}</code>
  <code class="install-copy__line">npm install -g @ciro-code/code</code>
  <code class="install-copy__line install-copy__line--comment">{commentStart}</code>
  <code class="install-copy__line">ciro web</code>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.install-copy').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-copy]');
    const label = root.querySelector<HTMLElement>('[data-label]');
    const command = root.dataset.command ?? '';
    if (!btn || !label) return;
    const idle = label.textContent ?? 'Copy';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(command);
        label.textContent = root.dataset.copied || 'Copied';
        btn.classList.add('is-copied');
        setTimeout(() => {
          label.textContent = idle;
          btn.classList.remove('is-copied');
        }, 2000);
      } catch {
        /* ignore */
      }
    });
  });
</script>
