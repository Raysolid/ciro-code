---
import config from 'virtual:starlight/user-config';

const title = typeof config.title === 'string' ? config.title : 'Ciro Code';
const isZh = Astro.locals.starlightRoute.locale === 'zh-cn';
const href = '/ciro-code/';
---

<a href={href} class="site-title sl-flex ciro-site-title">
  <span class="ciro-mark" aria-hidden="true">
    <svg width="24" height="24" viewBox="0 0 26 26" fill="none">
      <rect x="1" y="1" width="24" height="24" rx="6" fill="#0F6B57"></rect>
      <path
        d="M8 9.5 12 13l-4 3.5M14 17h4.5"
        stroke="#FAFAF8"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
  <span class="ciro-site-title__text" translate="no">{title}</span>
  <span class="ciro-site-title__badge">{isZh ? '文档' : 'docs'}</span>
</a>
