---
interface Props {
  title?: string;
  lines?: { kind?: 'cmd' | 'dim' | 'info' | 'success'; text: string; prompt?: string }[];
}

const {
  title = 'PowerShell — ciro web',
  lines = [
    { kind: 'cmd', prompt: 'PS C:\\Users\\dev\\project>', text: ' ciro web' },
    { kind: 'dim', text: '[info] Starting Ciro Code local workbench…' },
    { kind: 'dim', text: '[info] Workspace detected: ./my-project' },
    { kind: 'info', text: '[server] Listening at http://127.0.0.1:3080' },
    { kind: 'success', text: '[ready] Open the URL in your browser to start' },
    { kind: 'dim', text: '[hint] Press Ctrl+C to stop' },
  ],
} = Astro.props;
---

<div class="term-demo" aria-hidden="true">
  <div class="term-demo__header">
    <span class="term-demo__dot term-demo__dot--red"></span>
    <span class="term-demo__dot term-demo__dot--yellow"></span>
    <span class="term-demo__dot term-demo__dot--green"></span>
    <span class="term-demo__title">{title}</span>
  </div>
  <div class="term-demo__body">
    {
      lines.map((line) => (
        <div class:list={['term-demo__line', line.kind && `term-demo__line--${line.kind}`]}>
          {line.prompt && <span class="term-demo__prompt">{line.prompt}</span>}
          {line.text}
        </div>
      ))
    }
  </div>
</div>
