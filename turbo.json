{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["CIRO_AGENT_BACKEND", "CIRO_PORT", "CIRO_WORKSPACE", "CIRO_HOST"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["CIRO_AGENT_BACKEND", "CIRO_PORT", "CIRO_WORKSPACE", "CIRO_HOST"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
