---
import type { Messages } from '../i18n/en';

interface Props {
  t: Messages;
}

const { t } = Astro.props;
const letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G'];
---

<section class="faq-dialogue section" id="faq" data-anchor="faq">
  <div class="wrap">
    <article class="faq-agent" data-faq-panel>
      <div class="faq-agent__bar">
        <span class="faq-agent__dot" aria-hidden="true"></span>
        <span class="faq-agent__dot" aria-hidden="true"></span>
        <span class="faq-agent__dot" aria-hidden="true"></span>
        <span class="faq-agent__url">{t.faq.session}</span>
        <span class="faq-agent__live" aria-hidden="true"><i></i> live</span>
      </div>

      <header class="faq-agent__head">
        <p class="eyebrow">{t.faq.eyebrow}</p>
        <h2 set:html={t.faq.titleHtml} />
      </header>

      <div class="faq-agent__thread" data-faq-thread>
        <div class="faq-turn faq-turn--you" data-faq-user hidden>
          <div class="faq-turn__meta">
            <span class="faq-turn__who">{t.faq.you}</span>
            <span class="faq-turn__kind">prompt</span>
          </div>
          <div class="faq-turn__prompt">
            <p data-faq-user-text></p>
          </div>
        </div>

        <div class="faq-turn faq-turn--ai" data-faq-answer hidden>
          <div class="faq-turn__meta">
            <span class="faq-turn__who">{t.faq.agent}</span>
            <span class="faq-turn__kind">report</span>
          </div>
          <div class="faq-turn__report">
            <p class="faq-turn__body">
              <span data-faq-text></span>
              <span class="faq-turn__caret" data-faq-caret hidden></span>
            </p>
          </div>
        </div>
      </div>

      <div class="faq-ask" data-faq-ask>
        <div class="faq-ask__head">
          <span class="faq-ask__icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75"></circle>
              <path
                d="M9.5 9.5a2.5 2.5 0 1 1 3.6 2.25c-.7.4-1.1.9-1.1 1.75V14"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
              ></path>
              <circle cx="12" cy="17" r="0.9" fill="currentColor"></circle>
            </svg>
          </span>
          <span class="faq-ask__title">{t.faq.pick}</span>
        </div>
        <div class="faq-ask__body" role="listbox" aria-label={t.faq.pick}>
          {
            t.faq.items.map((item, i) => (
              <button
                type="button"
                class:list={['faq-ask__opt', i === 0 && 'is-active']}
                role="option"
                aria-selected={i === 0 ? 'true' : 'false'}
                data-faq-chip
                data-q={item.q}
                data-a={item.a}
              >
                <span class="faq-ask__letter">{letters[i] ?? String(i + 1)}</span>
                <span class="faq-ask__label">{item.q}</span>
              </button>
            ))
          }
        </div>
        <form class="faq-ask__foot" data-faq-form>
          <button type="submit" class="faq-ask__send" data-faq-send>
            {t.faq.send}
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M5 12h12M13 6l6 6-6 6"
                stroke="currentColor"
                stroke-width="1.85"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </button>
        </form>
      </div>
    </article>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function setCaret(caret: HTMLElement | null, on: boolean) {
    if (!caret) return;
    if (on) caret.removeAttribute('hidden');
    else caret.setAttribute('hidden', '');
  }

  function streamText(el: HTMLElement, text: string, caret: HTMLElement | null, signal: { cancelled: boolean }) {
    return new Promise<void>((resolve) => {
      el.textContent = '';
      if (reduce) {
        el.textContent = text;
        setCaret(caret, false);
        resolve();
        return;
      }
      setCaret(caret, true);
      let i = 0;
      const tick = () => {
        if (signal.cancelled) {
          setCaret(caret, false);
          resolve();
          return;
        }
        if (i >= text.length) {
          setCaret(caret, false);
          resolve();
          return;
        }
        i += 1 + (Math.random() > 0.85 ? 1 : 0);
        el.textContent = text.slice(0, Math.min(i, text.length));
        const thread = el.closest('[data-faq-thread]');
        if (thread) thread.scrollTop = thread.scrollHeight;
        window.setTimeout(tick, 14 + Math.random() * 22);
      };
      tick();
    });
  }

  const panel = document.querySelector<HTMLElement>('[data-faq-panel]');
  if (panel) {
    const form = panel.querySelector<HTMLFormElement>('[data-faq-form]');
    const chips = panel.querySelectorAll<HTMLButtonElement>('[data-faq-chip]');
    const userRow = panel.querySelector<HTMLElement>('[data-faq-user]');
    const userText = panel.querySelector<HTMLElement>('[data-faq-user-text]');
    const answerRow = panel.querySelector<HTMLElement>('[data-faq-answer]');
    const answerText = panel.querySelector<HTMLElement>('[data-faq-text]');
    const caret = panel.querySelector<HTMLElement>('[data-faq-caret]');
    const thread = panel.querySelector<HTMLElement>('[data-faq-thread]');

    let selected = chips[0] ?? null;
    let job = { cancelled: false };
    let busy = false;

    const selectChip = (chip: HTMLButtonElement) => {
      selected = chip;
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        if (busy) return;
        selectChip(chip);
      });
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!selected || !userRow || !userText || !answerRow || !answerText || busy) return;

      const q = selected.dataset.q ?? '';
      const a = selected.dataset.a ?? '';
      if (!q || !a) return;

      job.cancelled = true;
      setCaret(caret, false);
      job = { cancelled: false };
      busy = true;

      userText.textContent = q;
      userRow.removeAttribute('hidden');
      userRow.classList.add('is-in');

      answerText.textContent = '';
      answerRow.removeAttribute('hidden');
      void answerRow.offsetHeight;
      answerRow.classList.add('is-in');
      if (thread) thread.scrollTop = thread.scrollHeight;

      await streamText(answerText, a, caret, job);
      setCaret(caret, false);
      busy = false;
    });
  }
</script>
