---
import type { Messages } from '../i18n/en';

interface Props {
  t: Messages;
  homeHref: string;
}

const { t, homeHref } = Astro.props;
const github = 'https://github.com/Raysolid/ciro-code';
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={homeHref}>
      <span class="brand__mark" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
          <rect x="2" y="2" width="20" height="20" rx="5" fill="currentColor"></rect>
          <path
            d="M7.5 15.5 10.2 8h2.1l2.7 7.5h-2.05l-.5-1.55H10.1l-.52 1.55H7.5Zm3.05-3.15h1.85L11.5 9.4h-.05l-.9 2.95Z"
            fill="#0b1220"></path>
        </svg>
      </span>
      Ciro Code
    </a>
    <nav class="nav" aria-label="Primary">
      <a href={t.docsHref}>{t.nav.docs}</a>
      <a href={github} rel="me" target="_blank">{t.nav.github}</a>
      <a href={t.otherLocaleHref} hreflang={t.otherLocale === 'en' ? 'en' : 'zh-CN'}
        >{t.otherLocaleLabel}</a
      >
    </nav>
  </div>
</header>
