---
import type { Messages } from '../i18n/en';
import BrandWordmark from './BrandWordmark.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  t: Messages;
  homeHref: string;
}

const { t, homeHref } = Astro.props;
const github = 'https://github.com/Raysolid/ciro-code';
const navItems = [
  { href: '#hero', label: t.nav.product },
  { href: '#modes', label: t.nav.modes },
  { href: '#faq', label: t.nav.faq },
  { href: t.docsHref, label: t.nav.docs },
] as const;
---

<header class="site-header" data-site-header>
  <div class="wrap site-header__inner">
    <a class="brand" href={homeHref}>
      <BrandWordmark variant="nav" />
    </a>
    <nav class="nav-links" aria-label="Primary">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="nav-actions">
      <a
        class="icon-btn lang-btn"
        href={t.otherLocaleHref}
        hreflang={t.otherLocale === 'en' ? 'en' : 'zh-CN'}
        data-locale={t.locale}
        aria-label={t.nav.langSwitch}
        title={t.nav.langSwitch}
      >
        <span class="lang-btn__mark lang-btn__mark--en" aria-hidden="true">EN</span>
        <span class="lang-btn__mark lang-btn__mark--zh" aria-hidden="true">中</span>
      </a>
      <ThemeToggle label={t.theme.label} labelLight={t.theme.toLight} labelDark={t.theme.toDark} />
      <a
        class="icon-btn"
        href={github}
        rel="me"
        target="_blank"
        aria-label={t.nav.github}
        title={t.nav.github}
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
          ><path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path></svg
        >
      </a>
      <button
        type="button"
        class="icon-btn nav-toggle"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="site-nav-drawer"
        aria-label={t.nav.menuOpen}
        data-label-open={t.nav.menuOpen}
        data-label-close={t.nav.menuClose}
      >
        <svg
          class="nav-toggle__open"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          class="nav-toggle__close"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="nav-drawer" id="site-nav-drawer" data-nav-drawer hidden>
    <nav class="nav-drawer__nav" aria-label="Mobile">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const drawer = document.querySelector<HTMLElement>('[data-nav-drawer]');
  if (header && toggle && drawer) {
    const labelOpen = toggle.dataset.labelOpen || 'Open menu';
    const labelClose = toggle.dataset.labelClose || 'Close menu';
    const mq = window.matchMedia('(min-width: 48rem)');

    const setOpen = (open: boolean) => {
      header.classList.toggle('is-nav-open', open);
      document.documentElement.classList.toggle('is-nav-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? labelClose : labelOpen);
      drawer.hidden = !open;
    };

    toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-nav-open')));
    drawer.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
    mq.addEventListener('change', () => {
      if (mq.matches) setOpen(false);
    });
  }
</script>
