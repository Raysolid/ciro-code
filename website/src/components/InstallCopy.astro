---
interface Props {
  copyLabel: string;
  copiedLabel: string;
}

const { copyLabel, copiedLabel } = Astro.props;
const copyText = 'npm install -g @ciro-code/code && ciro web';
---

<div class="install-bar" data-command={copyText} data-copied={copiedLabel}>
  <code
    ><span class="prompt">$</span> npm install -g <span class="pkg">@ciro-code/code</span>
    <span class="prompt">&amp;&amp;</span> ciro web</code
  >
  <button type="button" class="install-bar__btn" data-copy aria-label={copyLabel}>
    <span data-label>{copyLabel}</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.install-bar').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-copy]');
    const label = root.querySelector<HTMLElement>('[data-label]');
    const command = root.dataset.command ?? '';
    if (!btn || !label) return;
    const idle = label.textContent ?? 'Copy';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(command);
        label.textContent = root.dataset.copied || 'Copied';
        btn.classList.add('is-copied');
        setTimeout(() => {
          label.textContent = idle;
          btn.classList.remove('is-copied');
        }, 1500);
      } catch {
        /* ignore */
      }
    });
  });
</script>
