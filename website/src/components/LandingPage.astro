---
import type { Messages } from '../i18n/en';
import Header from './Header.astro';
import InstallCopy from './InstallCopy.astro';
import ProductStage from './ProductStage.astro';
import MediaShowcase from './MediaShowcase.astro';
import ModesRail from './ModesRail.astro';
import StoryHighlights from './StoryHighlights.astro';
import FaqDialogue from './FaqDialogue.astro';
import ScrollTimeline from './ScrollTimeline.astro';
import BrandMark from './BrandMark.astro';

interface Props {
  t: Messages;
  homeHref: string;
}

const { t, homeHref } = Astro.props;
const github = 'https://github.com/Raysolid/ciro-code';
const security = `${github}/blob/main/SECURITY.md`;
const agents = `${github}/blob/main/AGENTS.md`;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Header t={t} homeHref={homeHref} />
<ScrollTimeline t={t} />

<main>
  <section class="hero" id="hero" data-reveal data-anchor="hero">
    <div class="hero__atmosphere" aria-hidden="true">
      <div class="hero__orb hero__orb--a" data-parallax="0.14"></div>
      <div class="hero__orb hero__orb--b" data-parallax="0.24"></div>
    </div>
    <div class="wrap hero__content">
      <div class="hero__badge">
        <span class="hero__badge-dot"></span>
        {t.hero.badge}
      </div>
      <h1 set:html={t.hero.titleHtml} />
      <p class="hero__tagline">{t.hero.tagline}</p>
      <InstallCopy copyLabel={t.hero.copyLabel} copiedLabel={t.hero.copiedLabel} />
      <p class="hero__hint" set:html={t.hero.hintHtml} />
      <div class="hero__actions">
        <a class="btn btn--accent" href="#quickstart">{t.nav.getStarted}</a>
        <a class="btn btn--raised" href={t.docsHref}>{t.hero.ctaDocs}</a>
        <a class="btn btn--raised" href={github} rel="me" target="_blank">{t.hero.ctaGithub}</a>
      </div>
    </div>
  </section>

  <ProductStage t={t} base={base} />
  <MediaShowcase t={t} base={base} />
  <ModesRail t={t} base={base} />
  <StoryHighlights t={t} />

  <section class="section section--band" id="quickstart" data-reveal data-anchor="quickstart">
    <div class="wrap qs-layout">
      <div class="qs-copy">
        <p class="eyebrow">{t.quickstart.eyebrow}</p>
        <h2>{t.quickstart.title}</h2>
        <p class="section__lead">{t.quickstart.lead}</p>
        <a class="text-link" href={t.docsQuickstartHref}>{t.quickstart.more}</a>
      </div>
      <div class="qs-panel">
        <div class="qs-panel__chrome">
          <span class="qs-panel__dot" aria-hidden="true"></span>
          <span class="qs-panel__dot" aria-hidden="true"></span>
          <span class="qs-panel__dot" aria-hidden="true"></span>
          <span class="qs-panel__path">{t.quickstart.path}</span>
        </div>
        <ol class="qs-steps">
          {
            t.quickstart.steps.map((s) => (
              <li class="qs-step">
                <div class="qs-step__rail" aria-hidden="true">
                  <span class="qs-step__n">{s.n}</span>
                </div>
                <div class="qs-step__body">
                  <h3>{s.title}</h3>
                  <p class="qs-step__hint">{s.hint}</p>
                  {'codeHtml' in s && s.codeHtml ? (
                    <pre class="qs-step__code" set:html={s.codeHtml} />
                  ) : (
                    <pre class="qs-step__code">{'code' in s ? s.code : ''}</pre>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <FaqDialogue t={t} />
</main>

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__brand">
      <BrandMark size={18} />
      <span>{t.footer.license}</span>
    </div>
    <nav>
      <a href={t.docsHref}>{t.footer.docs}</a>
      <a href={github} rel="me" target="_blank">{t.footer.github}</a>
      <a href={security} target="_blank">{t.footer.security}</a>
      <a href={agents} target="_blank">{t.footer.agents}</a>
      <a href={t.llmsHref}>llms.txt</a>
    </nav>
  </div>
</footer>

<script>
  import '../scripts/motion';
</script>
