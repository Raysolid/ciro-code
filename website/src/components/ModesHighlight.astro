---
import type { Messages } from '../i18n/en';
import ModeScene from './ModeScene.astro';

interface Props {
  t: Messages;
}

const { t } = Astro.props;
const items = t.modes.items;
const total = String(items.length).padStart(2, '0');
---

<section class="modes-hl" id="modes">
  <div class="modes-hl__track" data-modes-track style={`--modes-count: ${items.length}`}>
    <div class="modes-hl__sticky">
      <header class="modes-hl__head">
        <h2>{t.modes.title}</h2>
        <p>{t.modes.lead}</p>
      </header>

      <div class="modes-hl__frame">
        {
          items.map((m, i) => {
            const n = String(i + 1).padStart(2, '0');
            return (
              <article
                class:list={[
                  'modes-hl__panel',
                  `modes-hl__panel--${m.id}`,
                  i === 0 && 'is-active',
                ]}
                data-modes-panel={m.id}
                aria-hidden={i !== 0}
              >
                <div
                  class:list={['modes-hl__main', i % 2 === 1 && 'modes-hl__main--flip']}
                >
                  <div class="modes-hl__copy">
                    <div class="modes-hl__eyebrow">
                      <span class="modes-hl__dot" aria-hidden="true" />
                      <b>{m.title}</b>
                      <em>
                        {n} / {total}
                      </em>
                    </div>
                    <h3>{m.slogan}</h3>
                    <p class="modes-hl__desc">{m.body}</p>
                    <dl class="modes-hl__meta">
                      {m.meta.map((row) => (
                        <div>
                          <dt>{row.label}</dt>
                          <dd>{row.value}</dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                  <div class="modes-hl__visual" aria-hidden="true">
                    <ModeScene scene={m.scene} />
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
