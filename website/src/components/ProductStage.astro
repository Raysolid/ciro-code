---
import type { Messages } from '../i18n/en';
import WorkbenchVisual from './WorkbenchVisual.astro';

interface Props {
  t: Messages;
  base: string;
}

const { t, base } = Astro.props;
const media = {
  workbench: `${base}media/placeholder-workbench.svg`,
  diff: `${base}media/placeholder-diff.svg`,
  terminal: `${base}media/placeholder-terminal.svg`,
};
---

<section class="stage section section--band" id="product" data-reveal data-anchor="product">
  <div class="wrap">
    <p class="eyebrow">{t.stage.eyebrow}</p>
    <h2>{t.stage.title}</h2>
    <p class="section__lead" set:html={t.stage.lead.replace(/`([^`]+)`/g, '<code>$1</code>')} />

    <div class="stage__tabs" role="tablist" aria-label={t.stage.eyebrow}>
      {
        t.stage.tabs.map((tab, i) => (
          <button
            type="button"
            class:list={['stage__tab', i === 0 && 'is-active']}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-stage-tab={tab.id}
          >
            {tab.label}
          </button>
        ))
      }
    </div>

    <div class="stage__panels">
      <div class="stage__panel is-active" data-stage-panel="workbench" role="tabpanel">
        <WorkbenchVisual t={t} />
      </div>

      <div class="stage__panel" data-stage-panel="video" role="tabpanel" hidden>
        <div class="media-frame media-frame--video">
          <img src={media.workbench} alt="" width="1280" height="720" loading="lazy" />
          <button type="button" class="media-play" data-media-play aria-label={t.stage.video.play}>
            <span class="media-play__icon" aria-hidden="true"></span>
            <span>{t.stage.video.play}</span>
          </button>
          <div class="media-frame__meta">
            <strong>{t.stage.video.title}</strong>
            <span>{t.stage.video.caption}</span>
          </div>
        </div>
      </div>

      <div class="stage__panel" data-stage-panel="diff" role="tabpanel" hidden>
        <figure class="media-frame">
          <img src={media.diff} alt={t.showcase.items[1].alt} width="1280" height="720" loading="lazy" />
          <figcaption>{t.stage.mediaNote}</figcaption>
        </figure>
      </div>

      <div class="stage__panel" data-stage-panel="terminal" role="tabpanel" hidden>
        <figure class="media-frame">
          <img
            src={media.terminal}
            alt={t.showcase.items[2].alt}
            width="1280"
            height="720"
            loading="lazy"
          />
          <figcaption>{t.stage.mediaNote}</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<script>
  function bindStage(root: ParentNode = document) {
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-stage-tab]');
    const panels = root.querySelectorAll<HTMLElement>('[data-stage-panel]');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.dataset.stageTab;
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panels.forEach((p) => {
          const on = p.dataset.stagePanel === id;
          p.classList.toggle('is-active', on);
          p.hidden = !on;
        });
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-media-play]').forEach((btn) => {
      btn.addEventListener('click', () => {
        btn.classList.add('is-playing');
        const label = btn.querySelector('span:last-child');
        if (label) label.textContent = '…';
        setTimeout(() => {
          btn.classList.remove('is-playing');
          if (label) label.textContent = btn.getAttribute('aria-label') || 'Play';
        }, 1200);
      });
    });
  }
  bindStage();
</script>
