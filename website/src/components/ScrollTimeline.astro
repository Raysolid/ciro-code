---
import type { Messages } from '../i18n/en';

interface Props {
  t: Messages;
}

const { t } = Astro.props;

const nodes = [
  { id: 'hero', label: t.nav.product },
  { id: 'product', label: t.stage.eyebrow },
  { id: 'modes', label: t.nav.modes },
  { id: 'features', label: t.nav.features },
  { id: 'quickstart', label: t.nav.quickstart },
  { id: 'faq', label: t.nav.faq },
];
---

<nav class="scroll-rail" data-scroll-rail aria-label={t.scroll}>
  <ul class="scroll-rail__nodes">
    {
      nodes.map((n) => (
        <li>
          <a class="scroll-rail__node" href={`#${n.id}`} data-anchor-link={n.id}>
            <span class="scroll-rail__label">{n.label}</span>
            <span class="scroll-rail__capsule" aria-hidden="true"></span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
