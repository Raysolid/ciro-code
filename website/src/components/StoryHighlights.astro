---
import type { Messages } from '../i18n/en';
import FeatureVisual from './icons/FeatureVisual.astro';

interface Props {
  t: Messages;
}

const { t } = Astro.props;
---

<section class="story" id="features" data-anchor="features">
  <div class="wrap story__intro">
    <p class="eyebrow">{t.features.eyebrow}</p>
    <h2>{t.features.title}</h2>
  </div>
  <div class="story__stack" data-story-stack>
    {
      t.features.items.map((item, i) => (
        <article
          class:list={['story__card', i === 0 && 'is-active']}
          style={`--i: ${i}; z-index: ${i + 1}`}
          data-story-item
          data-index={i}
        >
          <div class="story__chrome">
            <span class="story__dot" aria-hidden="true"></span>
            <span class="story__dot" aria-hidden="true"></span>
            <span class="story__dot" aria-hidden="true"></span>
            <span class="story__path">{item.path}</span>
            <span class="story__tag">{item.tag}</span>
          </div>
          <div class="story__card-body">
            <div class="story__copy">
              <p class="story__n">{item.n}</p>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <ul class="story__points">
                {item.points.map((p) => (
                  <li>
                    <span class="story__check" aria-hidden="true"></span>
                    {p}
                  </li>
                ))}
              </ul>
            </div>
            <div class="story__visual">
              <div class="story__term">
                <div class="story__term-bar">
                  <span class="font-mono">{item.path.split('·')[0]?.trim()}</span>
                  <span class="story__term-stat">ok</span>
                </div>
                <div class="story__term-body">
                  <FeatureVisual kind={item.visual} />
                </div>
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
