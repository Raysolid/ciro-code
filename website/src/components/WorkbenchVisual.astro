---
import type { Messages } from '../i18n/en';

interface Props {
  t: Messages;
}

const { t } = Astro.props;
const w = t.workbench;
---

<div class="wb">
  <div class="wb__bar">
    <span class="wb__dot"></span>
    <span class="wb__dot"></span>
    <span class="wb__dot"></span>
    <span class="wb__url">{w.url}</span>
    <span class="wb__live" aria-hidden="true"><i></i> live</span>
  </div>
  <div class="wb__grid">
    <aside class="wb__side">
      <p class="wb__side-label">{w.workspace}</p>
      <ul style="margin:0;padding:0">
        <li class="wb__file is-active">src/app.ts</li>
        <li class="wb__file">src/policy.ts</li>
        <li class="wb__file">ciro.config.json</li>
        <li class="wb__file">AGENTS.md</li>
      </ul>
      <p class="wb__side-label">{w.packs}</p>
      <ul style="margin:0;padding:0">
        <li class="wb__file">@ciro-code/ext-git</li>
      </ul>
    </aside>
    <div class="wb__main">
      <div class="wb__modes">
        <span class="wb__mode">Ask</span>
        <span class="wb__mode">Plan</span>
        <span class="wb__mode is-active">Agent</span>
        <span class="wb__mode">Debug</span>
      </div>
      <div class="wb__msg">
        <div class="wb__avatar wb__avatar--you">You</div>
        <p set:html={w.userMsgHtml} />
      </div>
      <div class="wb__msg">
        <div class="wb__avatar wb__avatar--ai">C</div>
        <div>
          <p set:html={w.agentMsgHtml} />
          <div class="wb__diff wb__diff--in">
            <div class="wb__diff-head">
              <span class="font-mono">{w.diffFile}</span>
              <span class="stat">{w.diffStat}</span>
            </div>
            <pre set:html={w.diffPre} />
          </div>
          <p class="wb__test" set:html={w.testLineHtml} />
        </div>
      </div>
      <div class="wb__composer">
        {w.composer}
        <span class="wb__caret" aria-hidden="true"></span>
        <kbd>{w.send}</kbd>
      </div>
    </div>
  </div>
</div>
