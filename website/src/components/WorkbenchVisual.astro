---
import type { Messages } from '../i18n/en';

interface Props {
  t: Messages;
}

const { t } = Astro.props;
const w = t.workbench;
---

<div class="cw" data-cw aria-hidden="true">
  <aside class="cw__left">
    <div class="cw__brand" aria-label="Ciro">
      <svg class="cw__brand-mark" viewBox="0 0 388 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g fill="currentColor">
          <path
            fill-rule="evenodd"
            d="M 208.500 19.674 C 196.521 21.169, 177.969 26.997, 165.929 33.048 C 128.326 51.946, 100.021 91.764, 93.455 135 C 83.187 202.604, 128.701 270.106, 195.271 286.006 C 245.315 297.959, 298.435 279.776, 330.479 239.726 C 334.066 235.243, 337 230.751, 337 229.743 C 337 227.440, 334.706 225.255, 323.094 216.500 C 317.987 212.650, 312.010 208.037, 309.810 206.250 C 307.611 204.462, 305.133 203, 304.304 203 C 303.476 203, 299.471 205.677, 295.404 208.948 C 281.116 220.442, 265.853 226.837, 247.228 229.134 C 227.936 231.512, 206.142 227.079, 189.500 217.390 C 177.413 210.353, 166.253 198.516, 160.590 186.727 C 154.186 173.396, 152.644 165.846, 153.253 150.802 C 153.651 140.970, 154.276 137.016, 156.365 131.106 C 165.060 106.507, 185.454 88.602, 212.500 81.819 C 219.890 79.966, 224.183 79.568, 236.500 79.594 C 252.006 79.626, 260.235 81.058, 273.169 85.972 C 279.608 88.419, 292.083 96.245, 298.190 101.668 C 300.872 104.051, 303.638 106, 304.336 106 C 306.733 106, 337 81.069, 337 79.094 C 337 78.063, 335.052 74.583, 332.672 71.360 C 313.103 44.865, 281.818 25.866, 249 20.548 C 240.350 19.146, 216.803 18.638, 208.500 19.674"
          ></path>
          <path
            fill-rule="evenodd"
            d="M 202.073 143.635 C 200.357 145.816, 200 147.688, 200 154.500 C 200 164.743, 201.910 168, 207.918 168 C 214.133 168, 215.500 165.567, 215.500 154.500 C 215.500 146.768, 215.181 144.857, 213.595 143.105 C 210.737 139.947, 204.757 140.222, 202.073 143.635"
          ></path>
          <path
            fill-rule="evenodd"
            d="M 249.113 143.583 C 247.330 145.850, 247 147.628, 247 154.961 C 247 162.752, 247.240 163.876, 249.314 165.826 C 251.595 167.968, 255.286 168.595, 258.455 167.379 C 262.962 165.649, 264.681 151.872, 261.248 145 C 259.727 141.954, 258.964 141.461, 255.363 141.198 C 251.874 140.943, 250.896 141.317, 249.113 143.583"
          ></path>
        </g>
        <path
          fill-rule="evenodd"
          class="cw__brand-spark"
          d="M 334.298 116.816 C 333.687 117.193, 331.936 121.290, 330.405 125.920 C 328.875 130.550, 326.227 136.175, 324.521 138.419 C 320.958 143.105, 312.436 148.586, 306.280 150.150 C 297.708 152.328, 298.105 156.175, 307.191 158.986 C 320.386 163.069, 328.169 171.694, 331.349 185.760 C 332.490 190.808, 332.963 191.538, 335.268 191.811 C 337.606 192.089, 338.008 191.655, 338.980 187.811 C 343.082 171.589, 350.666 163.095, 364.762 158.934 C 373.460 156.367, 372.902 153.010, 363.192 149.494 C 350.723 144.979, 344.109 137.908, 340.433 125.160 C 338.340 117.904, 336.527 115.438, 334.298 116.816"
        ></path>
      </svg>
      <span class="cw__brand-rest">iro</span>
    </div>
    <button type="button" class="cw__new" tabindex="-1">{w.newChat}</button>
    <p class="cw__section">{w.workspace}</p>
    <p class="cw__workspace">{w.workspaceName}</p>
    <ul class="cw__sessions">
      {
        w.sessions.map((name, i) => (
          <li class:list={[i === 0 && 'is-active']}>{name}</li>
        ))
      }
    </ul>
    <div class="cw__left-foot">{w.settings}</div>
  </aside>

  <div class="cw__main">
    <header class="cw__top">
      <span>{w.headerTitle}</span>
      <button type="button" class="cw__panel-btn" tabindex="-1" aria-label={w.collapseRight}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="18" height="18" x="3" y="3" rx="2"></rect>
          <path d="M15 3v18"></path>
        </svg>
      </button>
    </header>

    <div class="cw__chat">
      <div class="cw__user" data-cw-user>
        <p data-cw-user-text></p>
      </div>
      <div class="cw__assistant" data-cw-assistant hidden>
        <div class="cw__think" data-cw-think hidden>
          <span data-cw-think-label>{w.stream.thinking}</span>
          <span class="cw__dots" data-cw-think-dots aria-hidden="true"><i></i><i></i><i></i></span>
        </div>
        <div class="cw__subagent" data-cw-subagent>
          <i></i>
          <span>{w.stream.subagent}</span>
        </div>
        <div class="cw__reply" data-cw-reply></div>
      </div>
    </div>

    <div class="cw__dock">
      <div class="cw__composer">
        <p class="cw__placeholder">{w.composerPlaceholder}</p>
        <div class="cw__composer-bar">
          <span class="cw__pill cw__pill--ask">{w.modeAsk}</span>
          <span class="cw__pill cw__pill--mute">{w.modelLabel}</span>
          <span class="cw__send" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#171717" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 19V5"></path>
              <path d="m5 12 7-7 7 7"></path>
            </svg>
          </span>
        </div>
      </div>
    </div>
  </div>

  <aside class="cw__right">
    <div class="cw__right-tabs">
      <span class="is-active">{w.filesTab}</span>
      <span>{w.changesTab}</span>
    </div>
    <ul class="cw__files">
      {
        w.fileTree.map((f, i) => (
          <li class:list={[i === 0 && 'is-active']}>{f}</li>
        ))
      }
    </ul>
  </aside>
</div>

<script define:vars={{ stream: w.stream }}>
  function prefersReduce() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  async function runLoop(root) {
    const user = root.querySelector('[data-cw-user]');
    const userText = root.querySelector('[data-cw-user-text]');
    const assistant = root.querySelector('[data-cw-assistant]');
    const think = root.querySelector('[data-cw-think]');
    const thinkLabel = root.querySelector('[data-cw-think-label]');
    const thinkDots = root.querySelector('[data-cw-think-dots]');
    const reply = root.querySelector('[data-cw-reply]');
    const sub = root.querySelector('[data-cw-subagent]');
    if (!user || !userText || !assistant || !think || !thinkLabel || !thinkDots || !reply || !sub) return;

    let visible = true;
    const io = new IntersectionObserver(
      ([entry]) => {
        visible = Boolean(entry?.isIntersecting);
      },
      { threshold: 0.12 },
    );
    io.observe(root);

    const waitVisible = () =>
      new Promise((resolve) => {
        const check = () => {
          if (!root.isConnected || visible) {
            resolve();
            return;
          }
          window.setTimeout(check, 400);
        };
        check();
      });

    const sleep = async (ms) => {
      await waitVisible();
      if (!root.isConnected) return;
      await new Promise((r) => window.setTimeout(r, ms));
      await waitVisible();
    };

    const typePlain = (el, plain, speed) =>
      new Promise(async (resolve) => {
        let i = 0;
        el.textContent = '';
        const tick = async () => {
          await waitVisible();
          if (!root.isConnected) {
            resolve();
            return;
          }
          i += 1;
          el.textContent = plain.slice(0, i);
          if (i >= plain.length) {
            resolve();
            return;
          }
          window.setTimeout(tick, speed);
        };
        tick();
      });

    const streamSegments = async (segments, speed) => {
      reply.innerHTML = '';
      for (const html of segments) {
        const seg = document.createElement('p');
        seg.className = 'cw__seg';
        reply.appendChild(seg);

        const tmp = document.createElement('div');
        tmp.innerHTML = html;
        const plain = tmp.textContent || '';

        if (prefersReduce()) {
          seg.innerHTML = html;
        } else {
          await typePlain(seg, plain, speed);
          seg.innerHTML = html;
          await sleep(220);
        }
      }
    };

    const setThinking = () => {
      think.classList.remove('is-done');
      thinkLabel.textContent = stream.thinking;
      thinkDots.classList.remove('is-off');
    };

    const markThought = () => {
      thinkLabel.textContent = stream.thought;
      thinkDots.classList.add('is-off');
      think.classList.add('is-done');
    };

    const reset = () => {
      user.classList.remove('is-in');
      userText.textContent = '';
      assistant.hidden = true;
      think.hidden = true;
      sub.classList.remove('is-on');
      setThinking();
      reply.innerHTML = '';
    };

    while (root.isConnected) {
      await waitVisible();
      if (!root.isConnected) break;
      reset();
      await sleep(450);
      userText.textContent = stream.user;
      user.classList.add('is-in');
      await sleep(1100);
      assistant.hidden = false;
      think.hidden = false;
      await sleep(900);
      sub.classList.add('is-on');
      await sleep(800);
      await streamSegments(stream.replySegments, 14);
      markThought();
      await sleep(2800);
    }

    io.disconnect();
  }

  document.querySelectorAll('[data-cw]').forEach((root) => {
    if (root.dataset.streamBound === '1') return;
    root.dataset.streamBound = '1';
    runLoop(root);
  });
</script>
