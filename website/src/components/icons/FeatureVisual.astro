---
interface Props {
  kind: string;
}

const { kind } = Astro.props;
---

<svg class="feature-visual" width="280" height="200" viewBox="0 0 280 200" fill="none" aria-hidden="true">
  {
    kind === 'policy' && (
      <>
        <rect x="24" y="28" width="232" height="144" rx="10" stroke="currentColor" class="fv-line" />
        <rect x="48" y="56" width="120" height="10" rx="3" class="fv-mute" />
        <rect x="48" y="80" width="184" height="10" rx="3" class="fv-mute" />
        <rect x="48" y="112" width="88" height="28" rx="6" class="fv-accent-fill" />
        <path d="M168 120h40l12 16-12 16h-40l-12-16 12-16Z" class="fv-accent" stroke-width="1.5" />
      </>
    )
  }
  {
    kind === 'local' && (
      <>
        <rect x="70" y="40" width="140" height="120" rx="12" stroke="currentColor" class="fv-line" />
        <rect x="94" y="64" width="92" height="8" rx="2" class="fv-mute" />
        <circle cx="140" cy="118" r="28" class="fv-accent" stroke-width="1.75" />
        <path d="M140 102v32M124 118h32" class="fv-accent" stroke-width="1.75" stroke-linecap="round" />
      </>
    )
  }
  {
    kind === 'packs' && (
      <>
        <rect x="36" y="44" width="96" height="52" rx="8" class="fv-accent" stroke-width="1.5" />
        <rect x="52" y="64" width="48" height="8" rx="2" class="fv-accent-fill" />
        <rect x="148" y="44" width="96" height="52" rx="8" stroke="currentColor" class="fv-line" />
        <rect x="164" y="64" width="56" height="8" rx="2" class="fv-mute" />
        <rect x="36" y="108" width="208" height="48" rx="8" stroke="currentColor" class="fv-line" />
        <circle cx="60" cy="132" r="8" class="fv-accent" stroke-width="1.5" />
        <rect x="80" y="128" width="100" height="8" rx="2" class="fv-mute" />
      </>
    )
  }
  {
    kind === 'skills' && (
      <>
        <rect x="36" y="44" width="88" height="112" rx="8" stroke="currentColor" class="fv-line" />
        <rect x="52" y="64" width="56" height="8" rx="2" class="fv-accent-fill" />
        <rect x="52" y="84" width="48" height="6" rx="2" class="fv-mute" />
        <rect x="52" y="100" width="52" height="6" rx="2" class="fv-mute" />
        <rect x="148" y="44" width="96" height="48" rx="8" class="fv-accent" stroke-width="1.5" />
        <rect x="148" y="108" width="96" height="48" rx="8" stroke="currentColor" class="fv-line" />
      </>
    )
  }
  {
    kind === 'model' && (
      <>
        <circle cx="140" cy="100" r="52" class="fv-accent" stroke-width="1.5" />
        <circle cx="140" cy="100" r="28" stroke="currentColor" class="fv-line" />
        <path d="M140 48v20M140 132v20M88 100h20M172 100h20" class="fv-mute" stroke-width="1.5" stroke-linecap="round" />
        <circle cx="140" cy="100" r="6" class="fv-accent-fill" />
      </>
    )
  }
</svg>

<style>
  .feature-visual {
    color: var(--ink-mute);
  }
  .fv-line {
    stroke: var(--ink-mute);
    opacity: 0.45;
  }
  .fv-mute {
    fill: var(--code-bg);
    stroke: none;
  }
  .fv-accent {
    stroke: var(--accent);
    fill: none;
  }
  .fv-accent-fill {
    fill: var(--accent-wash);
    stroke: var(--accent);
    stroke-width: 1;
  }
</style>
